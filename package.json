    "@opentelemetry/instrumentation": "^0.222.0",
    "@opentelemetry/sdk-logs": "^0.222.0",
    "@opentelemetry/sdk-metrics": "^2.11.0",
    "@tanstack/react-query": "^5.101.2",
    "@vercel/otel": "^2.1.3",
    "@walletconnect/ethereum-provider": "^2.24.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.28.0",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "pg": "^8.23.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "redis": "^6.2.1",
    "shadcn": "^4.19.1",

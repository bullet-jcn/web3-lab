{
  "name": "web3-lab",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "db:migrate": "node scripts/migrate.mjs",
    "lint": "eslint",
    "security:audit:all": "npm audit --audit-level=high",

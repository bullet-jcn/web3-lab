# Alchemy API key — https://dashboard.alchemy.com
# 同一个 key 通用于 Ethereum / Base 的主网与测试网，
# 具体如何拼出各链的 RPC URL 见 lib/rpc.ts
NEXT_PUBLIC_ALCHEMY_API_KEY=your-alchemy-api-key
# Production should configure a provider independent from Alchemy. If omitted,
# the chain's public RPC is used only as an emergency fallback and may be rate-limited.
# NEXT_PUBLIC_ETHEREUM_SEPOLIA_RPC_FALLBACK_URL=https://your-sepolia-provider.example
# NEXT_PUBLIC_ETHEREUM_MAINNET_RPC_FALLBACK_URL=https://your-mainnet-provider.example
# NEXT_PUBLIC_BASE_SEPOLIA_RPC_FALLBACK_URL=https://your-base-sepolia-provider.example
# NEXT_PUBLIC_BASE_MAINNET_RPC_FALLBACK_URL=https://your-base-mainnet-provider.example

# WalletConnect / Reown project ID — https://cloud.reown.com
# 这是公开客户端标识，会在构建时进入浏览器 bundle；缺失时 UI 会明确禁用 WalletConnect。
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your-walletconnect-project-id

# 服务端专用（不加 NEXT_PUBLIC_ 前缀，不会被打进浏览器 bundle）
# 用于给 SIWE nonce / session cookie 签名，生成方式：openssl rand -base64 32
AUTH_COOKIE_SECRET=your-random-secret

# 服务端专用 —— https://aistudio.google.com/apikey（免费额度，无需信用卡）
# 用于 AI 安全副驾驶（app/api/risk-copilot）把结构化风险检测结果转成人话
GEMINI_API_KEY=your-gemini-api-key

# Milestone 4 server-side persistence. Never expose these with NEXT_PUBLIC_.
DATABASE_URL=postgresql://web3_lab:local_web3_lab_only@127.0.0.1:5432/web3_lab
REDIS_URL=redis://127.0.0.1:6379
# Required in production. Use legacy-cookie only as an explicit rollback mode.
BACKEND_STORAGE_MODE=postgres
# Optional bounded pool/timeout overrides.
DATABASE_POOL_MAX=10
DATABASE_CONNECT_TIMEOUT_MS=5000
DATABASE_STATEMENT_TIMEOUT_MS=10000

# Server-only OpenTelemetry export. Omit locally to keep JSON logs without remote export.
# Never prefix collector credentials with NEXT_PUBLIC_.
# OTEL_EXPORTER_OTLP_ENDPOINT=https://your-otel-collector.example
# Optional signal-specific override; the HTTP exporter appends /v1/metrics to the base endpoint above.
# OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=https://your-otel-collector.example/v1/metrics
# OTEL_EXPORTER_OTLP_HEADERS=authorization=Bearer%20your-secret
# OTEL_TRACES_SAMPLER=parentbased_traceidratio
# OTEL_TRACES_SAMPLER_ARG=0.1
